,rgba(18,52,44,.88));border-color:rgba(255,255,255,.08)}
.brand{grid-area:brand;display:flex;align-items:center;gap:10px;min-width:0}.brand .logo{width:46px;height:46px;border-radius:17px;background:linear-gradient(145deg,#fff,#e8f7f2);padding:3px;box-shadow:0 10px 24px rgba(15,118,110,.22)}.brandcopy{display:flex;min-width:0;flex-direction:column;gap:2px}.brandcopy b{font-size:20px;line-height:1;letter-spacing:-.65px}.brandcopy small{font-size:11px;font-weight:750;color:var(--teal);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:230px}.themebtn{grid-area:theme;width:44px;height:44px;border-radius:16px;align-self:center}.search{grid-area:search;height:48px;border:0;border-radius:17px;background:rgba(255,255,255,.72);box-shadow:inset 0 0 0 1px rgba(15,118,110,.09),0 7px 20px rgba(15,75,64,.06);padding:0 5px 0 12px}.searchlead{display:grid;place-items:center;color:var(--teal)}.searchlead svg{width:20px;height:20px}.search input{font-size:14px;font-weight:620}.search button{width:auto;padding:0 13px;border-radius:13px;background:linear-gradient(135deg,var(--nav),var(--nav2));color:#fff;font-weight:800}.search button svg{display:none}.search button span{display:inline}
[data-theme="dark"] .search{background:rgba(10,25,21,.52)}
.fabcol{top:175px;right:11px;padding:6px;border-radius:22px;background:rgba(255,255,255,.74);border:1px solid rgba(255,255,255,.65);box-shadow:0 14px 38px rgba(8,55,45,.16);backdrop-filter:blur(18px)}[data-theme="dark"] .fabcol{background:rgba(20,42,35,.82);border-color:rgba(255,255,255,.08)}.fabcol .iconbtn{width:46px;height:46px;border-radius:15px;box-shadow:none;border:0;background:transparent}.fabcol .iconbtn.active,.fabcol .iconbtn.gps-on{background:var(--tealSoft);color:var(--teal)}
.map-hud{position:absolute;z-index:615;left:12px;bottom:92px;display:flex;align-items:center;gap:7px;padding:8px 10px;border-radius:15px;background:var(--hud);color:#fff;box-shadow:0 10px 28px rgba(0,0,0,.22);backdrop-filter:blur(14px);font:650 10px/1.2 system-ui}.map-hud span{max-width:145px}.map-hud b{font-size:10px}.map-hud i{font-style:normal;padding:3px 6px;border-radius:999px;background:rgba(255,255,255,.11);opacity:.65}.map-hud i.on{background:rgba(72,213,169,.19);color:#90f0cb;opacity:1}
.nav{height:76px;bottom:max(8px,env(safe-area-inset-bottom));border-radius:28px;padding:7px;background:rgba(250,253,252,.93);border:1px solid rgba(255,255,255,.78);box-shadow:0 22px 58px rgba(7,45,38,.24)}[data-theme="dark"] .nav{background:rgba(20,40,34,.94);border-color:rgba(255,255,255,.08)}.nav button{border-radius:20px;font-size:9.5px;font-weight:760;letter-spacing:-.1px}.nav button svg{width:22px;height:22px}.nav button.active{background:linear-gradient(145deg,#0f766e,#18a999);box-shadow:0 10px 24px rgba(15,118,110,.32);transform:translateY(-2px)}
.sheet{bottom:94px;max-height:min(73vh,720px);border-radius:32px 32px 24px 24px;border:1px solid rgba(255,255,255,.65);box-shadow:0 28px 80px rgba(6,43,36,.28)}.sheet header h2{font-size:21px;letter-spacing:-.55px}.sheet .body{padding:4px 15px 24px}.sheet .grab{width:56px;height:5px;background:rgba(80,105,96,.25)}
.card{border-radius:22px}.item{min-height:62px;border-radius:20px;padding:12px 13px}.folder{border-radius:22px}.btn{min-height:42px;border-radius:16px}.modal .box{width:min(94vw,620px);max-height:88vh;overflow:auto;border-radius:30px;padding:21px;background:linear-gradient(160deg,var(--panel),var(--panel2));border:1px solid rgba(255,255,255,.55)}.modal-kicker{font-size:10px;font-weight:900;letter-spacing:1.7px;color:var(--teal);margin-bottom:5px}.modal h3{font-size:23px;letter-spacing:-.7px}.field label{font-size:11px;font-weight:800;letter-spacing:.1px}.field input,.field select,.field textarea{min-height:46px;border-radius:16px}
.wp-popup{min-width:205px}.wp-popup-icon{font-size:26px}.wp-popup-notes{font-size:12px;margin:3px 0;color:#5f7069}.wp-popup-coord{font-size:11px;color:#76857f;margin:5px 0 9px}.wp-popup-actions{display:grid;grid-template-column