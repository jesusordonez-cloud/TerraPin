  return `<div class="pdf-page"><div class="pdf-hero"><img src="icon-512.png"><div><strong>TerraPin</strong><b>${esc(d.title)}</b><span>Reporte de campo · ${esc(fmtDate(Date.now()))}</span></div></div><div class="pdf-kpis"><div><b>${d.tracks.length}</b><span>Rutas</span></div><div><b>${d.waypoints.length}</b><span>Puntos</span></div><div><b>${fmtDist(d.totalDist)}</b><span>Distancia</span></div><div><b>${fmtTime(d.totalTime)}</b><span>Tiempo</span></div></div><div class="pdf-map">${reportSvg(d.tracks,d.waypoints)}</div><h4>Rutas registradas</h4>${rowsT}<h4>Puntos de campo</h4>${rowsW}<footer>TerraPin · SIG de campo y navegación</footer></div>`;
