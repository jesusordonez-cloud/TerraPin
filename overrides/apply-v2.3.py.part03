bd){bd=d;bi=i}}let rem=hav([ll.lat,ll.lng],r.coords[bi]);for(let i=bi+1;i<r.coords.length;i++)rem+=hav(r.coords[i-1],r.coords[i]);$('#routeRemain').textContent=fmtDist(rem);const eta=r.dur&&r.dist?Math.max(0,r.dur*(rem/r.dist)):null;$('#routeEta').textContent=eta?fmtTime(eta):'—';const status=$('#routeStatus');status.textContent=bd>120?'Fuera de ruta · conviene recalcular':(rem<35?'Destino muy cerca':'Navegación activa');status.classList.toggle('warn',bd>120);
};
const chooseRouteDialog = (routes,target) => {
  const cards=routes.map((r,i)=>`<button class="route-option-card" data-pickroute="${r.id}"><span class="route-net ${r.source}">${r.source==='local'?'SIG':r.source==='osm'?'OSM':'↗'}</span><span class="grow"><b>${esc(r.label)}</b><small>${esc(r.detail||'')} · ${fmtDist(r.dist)}${r.dur?' · '+fmtTime(r.dur):''}</small></span><span>›</span></button>`).join('');
  openModal(`<div class="modal-kicker">NAVEGACIÓN</div><h3>Ruta a ${esc(target.name||'punto')}</h3><p class="muted">Elige la red a utilizar. Las rutas SIG funcionan con las líneas cargadas en TerraPin; OSM requiere internet.</p><div class="route-option-list">${cards}</div><div class="actions"><button class="btn ghost" data-close>Cancelar</button></div>`);document.querySelectorAll('[data-pickroute]').forEach(b=>b.onclick=()=>{const r=routes.find(x=>x.id===b.dataset.pickroute);closeModal();activateRoute(r,target,routes);});
};
const routeToWaypoint = async w => {
  toast('Calculando rutas…');try{const from=await ensureCurrentLocation();const [local,osm]=await Promise.all([Promise.resolve(localRoutes(from,L.latLng(w.lat,w.lng))),onlineRoutes(from,L.latLng(w.lat,w.lng))]);let routes=[...local,...osm];if(!routes.length)routes=[directRoute(from,L.latLng(w.lat,w.lng))];routes.sort((a,b)=>{if(a.source==='direct')return 1;if(b.source==='direct')return-1;return (a.dur||a.dist)-(b.dur||b.dist)});if(routes.length===1)activateRoute(routes[0],w,routes);else chooseRouteDialog(routes,w);}catch(e){console.error(e);toast('No se pudo obtener tu ubicación para navegar');}
};
$('#routeClose').onclick=closeNavigation;
$('#routeRecalc').onclick=()=>{if(!S.nav)return;const t=S.nav.target;closeNavigation();routeToWaypoint(t);};

