s:1.25fr 1fr;gap:6px}.wp-popup-actions button{border:0;border-radius:11px;padding:9px 10px;font-weight:800}.wp-nav{background:#0f766e;color:#fff}.wp-edit{background:#eef4f1;color:#24443b}
.route-card{position:absolute;z-index:625;left:10px;right:10px;bottom:94px;display:none;padding:13px;border-radius:26px;background:linear-gradient(145deg,rgba(10,39,34,.96),rgba(13,75,65,.94));color:#fff;box-shadow:0 24px 68px rgba(3,34,29,.38);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.13)}.route-card.open{display:block}.route-top{display:flex;align-items:center;gap:11px}.route-arrow{width:44px;height:44px;display:grid;place-items:center;border-radius:15px;background:linear-gradient(135deg,#22c4aa,#0f9482);font-size:25px;box-shadow:0 8px 20px rgba(0,0,0,.18)}.route-top small,.route-top b,.route-top span{display:block}.route-top small{font-size:10px;color:#9be8d3;text-transform:uppercase;font-weight:850;letter-spacing:.6px}.route-top small.warn{color:#ffd27b}.route-top b{font-size:18px;letter-spacing:-.4px;margin-top:1px}.route-top span{font-size:11px;color:#c6ddd6;margin-top:2px}.route-x{border:0;background:rgba(255,255,255,.1);color:#fff;width:36px;height:36px;border-radius:13px}.route-metrics{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:7px;margin-top:11px}.route-metrics>div{background:rgba(255,255,255,.08);padding:8px;border-radius:13px}.route-metrics b,.route-metrics span{display:block}.route-metrics b{font-size:14px}.route-metrics span{font-size:9px;color:#b9d1ca}.route-metrics button{border:0;border-radius:13px;padding:0 11px;background:#fff;color:#0f665b;font-weight:850}.route-choices{display:flex;gap:6px;overflow:auto;margin-top:9px;padding-bottom:1px}.route-choice{flex:0 0 auto;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);color:#fff;border-radius:13px;padding:7px 9px;text-align:left}.route-choice b,.route-choice span{display:block}.route-choice b{font-size:10px}.route-choice span{font-size:9px;color:#b9d1ca;margin-top:2px}.route-choice.active{background:#fff;color:#0c574e}.route-choice.active span{color:#51766d}
.route-option-list{display:grid;gap:8px;margin:14px 0}.route-option-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:11px;text-align:left;color:var(--ink)}.route-option-card small,.route-option-card b{display:block}.route-option-card small{margin-top:3px;color:var(--ink2);font-size:11px}.route-net{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;font-size:11px;font-weight:900;color:#fff}.route-net.local{background:linear-gradient(135deg,#8b5cf6,#6d28d9)}.route-net.osm{background:linear-gradient(135deg,#0f766e,#18a999)}.route-net.direct{background:#f59e0b}
.preview-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.preview-head h3{margin-bottom:2px}.preview-head p{margin:0;color:var(--ink2);font-size:12px}.pdf-preview-wrap{background:#cfd9d5;padding:12px;border-radius:20px;margin:14px -4px;max-height:58vh;overflow:auto}.pdf-page{background:#fff;color:#14251f;width:100%;max-width:520px;margin:auto;min-height:690px;border-radius:5px;padding:18px;box-shadow:0 12px 38px rgba(0,0,0,.18)}.pdf-hero{background:linear-gradient(135deg,#0f766e,#149884);color:#fff;border-radius:16px;padding:13px;display:flex;gap:12px;align-items:center}.pdf-hero img{width:54px;height:54px;border-radius:13px;background:#fff;object-fit:contain}.pdf-hero strong,.pdf-hero b,.pdf-hero span{display:block}.pdf-hero strong{font-size:22px}.pdf-hero b{font-size:11px;margin-top:2px}.pdf-hero span{font-size:8px;opacity:.85;margin-top:2px}.pdf-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:10px 0}.pdf-kpis div{background:#eff7f4;border-radius:10px;padding:8px}.pdf-kpis b,.pdf-kpis span{display:block}.pdf-kpis b{color:#0f766e;font-size:13px}.pdf-kpis span{font-size:8px;color:#687972}.pdf-map svg{width:100%;height:auto;display:block}.pdf-page h4{font-size:11px;m